# ─── Secrets ──────────────────────────────────────────────
# AVAILABILITY_SECRET / AVAILABILITY_ANSWERS / CALENDAR_EMBED_URL
# live in Vercel project env vars, never in the repo.
.env
.env.*
!.env.example

# ─── Vercel ───────────────────────────────────────────────
.vercel

# ─── Nextcloud sync artefacts ─────────────────────────────
# This repo lives inside a synced Nextcloud folder, so conflict
# copies can appear mid-edit. Never commit them.
*conflicted copy*
*_conflict-*
*.~lock.*

# ─── Windows ──────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
~$*

# ─── macOS ────────────────────────────────────────────────
.DS_Store
._*

# ─── Editors ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Node (only if tooling is added later) ────────────────
node_modules/
npm-debug.log*

# Image sources (originals); built WebP variants in assets/img/w* are committed
assets/img/_src/
